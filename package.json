{
  "name": "rp-historical-purge",
  "version": "1.1.1",
  "private": true,
  "description": "Purga histórica segura y programada para Recinto Protegido",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:once": "node dist/index.js --once",
    "dev": "tsx src/index.ts",
    "dev:once": "tsx src/index.ts --once",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "croner": "^9.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
