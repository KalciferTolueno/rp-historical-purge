# API de Supabase/Kong, sin /project/default.
SUPABASE_URL=http://192.168.1.205:8000

# Se configura únicamente como secreto en EasyPanel. Nunca se sube al repo.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Seguridad: dry-run no elimina nada. Cambiar a execute sólo tras validar logs.
PURGE_MODE=dry-run

# Retención móvil; por seguridad el mínimo aceptado es 30 días.
RETENTION_DAYS=60

# Domingo 03:30, usando la zona horaria indicada.
PURGE_SCHEDULE=30 3 * * 0
TZ=America/Santiago

# Para la primera validación se puede ejecutar una vista previa al arrancar.
RUN_ON_START=false

# Límites conservadores por ejecución. Si se alcanzan, continúa la semana siguiente.
MAX_STORAGE_DELETES_PER_RUN=5000
MAX_CRA_DELETES_PER_RUN=50000
BATCH_DELAY_MS=150

# Protección adicional por presión de disco. Primero validar en dry-run que
# totalGiB coincida con el disco del servidor antes de usar execute.
DISK_MONITOR_ENABLED=false
DISK_PATH=/
DISK_TRIGGER_PERCENT=90
DISK_REARM_PERCENT=85
DISK_CHECK_INTERVAL_MINUTES=5
DISK_TRIGGER_COOLDOWN_HOURS=6
DISK_PRESSURE_RETENTION_DAYS=30
